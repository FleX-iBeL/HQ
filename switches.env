# Phase K, lighter calls (9 October 2026). 1 = on, 0 = off. Restart the line after a change.
# Everything back as it was before phase K: the git tag before-phase-K.
JARVIS_LIGHT_NOTES=1      # K1: Quick has only the open commitments from the notes
JARVIS_NO_DOCS=1          # K2: no Claude Docs on calls
JARVIS_TOOLS_ON_DEMAND=1  # K3: mail and calendar tools loaded when needed
JARVIS_CHEAP_AFTER_CALL=1 # K4: the after-call work on Haiku
